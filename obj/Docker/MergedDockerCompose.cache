name: dockercompose6588692087492687233
services:
  basket:
    build:
      context: D:\Development(imp)\CURRENT\IMPIMP\Udemy-course-code\New\My-code\ECommerce Project\Ecommerce
      dockerfile: Services/Basket/Basket.API/Dockerfile
    depends_on:
      basketdb:
        condition: service_started
        required: true
      rabbitmq:
        condition: service_started
        required: true
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      CacheSettings__ConnectionString: basketdb:6379
      ElasticConfiguration__Uri: http://elasticsearch:9200
      EventBusSettings__HostAddress: amqp://guest:guest@rabbitmq:5672/
      GrpcSettings__DiscountUrl: http://discount:8080
    image: basket
    networks:
      default: null
    ports:
      - mode: ingress
        target: 8080
        published: "8001"
        protocol: tcp
  basketdb:
    container_name: basketdb
    image: redis:alpine
    networks:
      default: null
    ports:
      - mode: ingress
        target: 6379
        published: "6379"
        protocol: tcp
    restart: always
  catalog:
    build:
      context: D:\Development(imp)\CURRENT\IMPIMP\Udemy-course-code\New\My-code\ECommerce Project\Ecommerce
      dockerfile: Services/Catalog/Catalog.API/Dockerfile
    depends_on:
      catalogdb:
        condition: service_started
        required: true
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      DatabaseSettings__BrandCollectionName: Brands
      DatabaseSettings__ConnectionString: mongodb://catalogdb:27017
      DatabaseSettings__DatabaseName: CatalogDb
      DatabaseSettings__ProductCollectionName: Products
      DatabaseSettings__TypeCollectionName: Types
      ElasticConfiguration__Uri: http://elasticsearch:9200
    image: catalog
    networks:
      default: null
    ports:
      - mode: ingress
        target: 8080
        published: "8000"
        protocol: tcp
  catalogdb:
    container_name: catalogdb
    image: mongo
    networks:
      default: null
    ports:
      - mode: ingress
        target: 27017
        published: "27017"
        protocol: tcp
    restart: always
    volumes:
      - type: volume
        source: mongo_data
        target: /data/db
        volume: {}
  discount:
    build:
      context: D:\Development(imp)\CURRENT\IMPIMP\Udemy-course-code\New\My-code\ECommerce Project\Ecommerce
      dockerfile: Services/Discount/Discount.API/Dockerfile
    depends_on:
      discountdb:
        condition: service_healthy
        required: true
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      DatabaseSettings__ConnectionString: Server=discountdb;Port=5432;Database=DiscountDb;User Id=admin;Password=Password@1;
      ElasticConfiguration__Uri: http://elasticsearch:9200
    image: discount
    networks:
      default: null
    ports:
      - mode: ingress
        target: 8080
        published: "8002"
        protocol: tcp
  discountdb:
    container_name: discountdb
    environment:
      POSTGRES_DB: DiscountDb
      POSTGRES_PASSWORD: Password@1
      POSTGRES_USER: admin
    healthcheck:
      test:
        - CMD-SHELL
        - pg_isready -U admin
      timeout: 5s
      interval: 10s
      retries: 5
    image: postgres:14
    networks:
      default: null
    ports:
      - mode: ingress
        target: 5432
        published: "5432"
        protocol: tcp
    restart: always
    volumes:
      - type: volume
        source: postgres_data
        target: /var/lib/postgresql/data
        volume: {}
  elasticsearch:
    container_name: elasticsearch
    environment:
      ES_JAVA_OPTS: -Xms512m -Xmx512m
      discovery.type: single-node
      xpack.security.enabled: "false"
    image: docker.elastic.co/elasticsearch/elasticsearch:8.14.3
    networks:
      default: null
    ports:
      - mode: ingress
        target: 9200
        published: "9200"
        protocol: tcp
    volumes:
      - type: volume
        source: elasticsearch-data
        target: /usr/share/elasticsearch/data
        volume: {}
  identity:
    build:
      context: D:\Development(imp)\CURRENT\IMPIMP\Udemy-course-code\New\My-code\ECommerce Project\Ecommerce
      dockerfile: Services/Identity/Identity/Dockerfile
    depends_on:
      identitydb:
        condition: service_started
        required: true
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ConnectionStrings__IdentityConnection: Server=identitydb;Database=IdentityDb;User Id=sa;Password=StrongPassword123!;TrustServerCertificate=True;
      ElasticConfiguration__Uri: http://elasticsearch:9200
      Jwt__Audience: ecommerce.clients
      Jwt__DurationInMinutes: "60"
      Jwt__Issuer: ecommerce.identity
      Jwt__Key: super_secure_secret_key_1234567890!@#
    image: identity
    networks:
      default: null
    ports:
      - mode: ingress
        target: 8080
        published: "8005"
        protocol: tcp
  identitydb:
    container_name: identitydb
    environment:
      ACCEPT_EULA: "Y"
      SA_PASSWORD: StrongPassword123!
    healthcheck:
      test:
        - CMD-SHELL
        - /opt/mssql-tools/bin/sqlcmd -S localhost -U sa -P 'StrongPassword123!' -Q 'select 1'
      timeout: 10s
      interval: 10s
      retries: 3
    image: mcr.microsoft.com/mssql/server:2022-latest
    networks:
      default: null
    ports:
      - mode: ingress
        target: 1433
        published: "1434"
        protocol: tcp
    restart: always
    volumes:
      - type: volume
        source: identitydb-data
        target: /var/opt/mssql
        volume: {}
  kibana:
    container_name: kibana
    depends_on:
      elasticsearch:
        condition: service_started
        required: true
    environment:
      ELASTICSEARCH_URL: http://elasticsearch:9200
    image: docker.elastic.co/kibana/kibana:8.14.3
    networks:
      default: null
    ports:
      - mode: ingress
        target: 5601
        published: "5601"
        protocol: tcp
  ocelot.apigateway:
    build:
      context: D:\Development(imp)\CURRENT\IMPIMP\Udemy-course-code\New\My-code\ECommerce Project\Ecommerce
      dockerfile: ApiGateway/ApiGateway/Dockerfile
    depends_on:
      basket:
        condition: service_started
        required: true
      catalog:
        condition: service_started
        required: true
      discount:
        condition: service_started
        required: true
      identity:
        condition: service_started
        required: true
      ordering:
        condition: service_started
        required: true
      payment:
        condition: service_started
        required: true
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      Jwt__Audience: ecommerce.clients
      Jwt__Issuer: ecommerce.identity
      Jwt__Key: super_secure_secret_key_1234567890!@#
    image: ocelotapigateway
    networks:
      default: null
    ports:
      - mode: ingress
        target: 8080
        published: "8010"
        protocol: tcp
  orderdb:
    container_name: orderdb
    environment:
      ACCEPT_EULA: "Y"
      SA_PASSWORD: StrongPassword123!
    healthcheck:
      test:
        - CMD-SHELL
        - /opt/mssql-tools/bin/sqlcmd -S localhost -U sa -P 'StrongPassword123!' -Q 'select 1'
      timeout: 10s
      interval: 10s
      retries: 3
    image: mcr.microsoft.com/mssql/server:2022-latest
    networks:
      default: null
    ports:
      - mode: ingress
        target: 1433
        published: "1433"
        protocol: tcp
    restart: always
    volumes:
      - type: volume
        source: orderdb-data
        target: /var/opt/mssql
        volume: {}
  ordering:
    build:
      context: D:\Development(imp)\CURRENT\IMPIMP\Udemy-course-code\New\My-code\ECommerce Project\Ecommerce
      dockerfile: Services/Ordering/Ordering.API/Dockerfile
    depends_on:
      orderdb:
        condition: service_started
        required: true
      rabbitmq:
        condition: service_started
        required: true
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ConnectionStrings__OrderingConnectionString: Server=orderdb;Database=OrderDb;User Id=sa;Password=StrongPassword123!;TrustServerCertificate=True;Encrypt=False;
      ElasticConfiguration__Uri: http://elasticsearch:9200
      EventBusSettings__HostAddress: amqp://guest:guest@rabbitmq:5672/
    image: orderingapi
    networks:
      default: null
    ports:
      - mode: ingress
        target: 8080
        published: "8003"
        protocol: tcp
  payment:
    build:
      context: D:\Development(imp)\CURRENT\IMPIMP\Udemy-course-code\New\My-code\ECommerce Project\Ecommerce
      dockerfile: Services/Payment/Payment/Dockerfile
    depends_on:
      rabbitmq:
        condition: service_started
        required: true
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ElasticConfiguration__Uri: http://elasticsearch:9200
      EventBusSettings__HostAddress: amqp://guest:guest@rabbitmq:5672/
    image: payment
    networks:
      default: null
    ports:
      - mode: ingress
        target: 8080
        published: "8004"
        protocol: tcp
  rabbitmq:
    container_name: rabbitmq
    image: rabbitmq:3-management-alpine
    networks:
      default: null
    ports:
      - mode: ingress
        target: 5672
        published: "5672"
        protocol: tcp
      - mode: ingress
        target: 15672
        published: "15672"
        protocol: tcp
    restart: always
networks:
  default:
    name: dockercompose6588692087492687233_default
volumes:
  elasticsearch-data:
    name: dockercompose6588692087492687233_elasticsearch-data
  identitydb-data:
    name: dockercompose6588692087492687233_identitydb-data
  mongo_data:
    name: dockercompose6588692087492687233_mongo_data
  orderdb-data:
    name: dockercompose6588692087492687233_orderdb-data
  postgres_data:
    name: dockercompose6588692087492687233_postgres_data